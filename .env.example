# Desarrollo local. Use una clave larga, aleatoria y diferente por entorno.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Use DB_ENGINE=postgresql fuera del desarrollo local.
DB_ENGINE=sqlite
DB_NAME=novadesk
DB_USER=novadesk
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Token exclusivo para los agentes de monitoreo. Debe rotarse periodicamente.
NOVADESK_AGENT_TOKEN=replace-with-a-long-random-agent-token
NOVADESK_HEARTBEAT_MAX_BYTES=65536

# Web Push. La clave privada debe suministrarse como secreto del entorno.
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com

# Produccion (se aplican cuando DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
